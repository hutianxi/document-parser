<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <!-- 只借用它的依赖版本管理（java.version、jackson、JUnit 5），产物是普通库 jar，没有 Spring 启动类 -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <!-- groupId 用 Central Portal 上已验证的域名型命名空间 cn.net.tianxi（Org: Tianxi，状态 Verified），
         与 Java 包名 cn.net.tianxi.document 保持一致 -->
    <groupId>cn.net.tianxi</groupId>
    <artifactId>document-parser</artifactId>
    <version>1.2.1</version>
    <name>document-parser</name>
    <description>文档解析模块：把 Word/PDF/PPT 统一解析成文本、表格、图片三个集合。源码 GitHub hutianxi/document-parser，国内镜像 Gitee mailtianxi/document-parser</description>
    <url>https://github.com/hutianxi/document-parser</url>
    <inceptionYear>2026</inceptionYear>

    <!-- 下面四段（licenses / developers / scm / issueManagement）是发布到 Maven Central 的硬性要求，
         缺任何一段 central-publishing-maven-plugin 的校验都会不通过。
         SCM 类型里 url/connection/developerConnection 都是 1..1，issueManagement 也只能有一个，
         写第二个会被解析时丢弃。所以两个仓库这样分工：connection 放 Gitee 镜像（只读），
         developerConnection 与 url 放 GitHub 主仓库，issueManagement 指向 GitHub Issues。 -->
    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>可自由使用、修改、再分发，须保留 LICENSE 与 NOTICE 里的原作者署名</comments>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>hutianxi</id>
            <name>hutianxi</name>
            <email>mailtianxi@qq.com</email>
            <url>https://github.com/hutianxi</url>
            <roles>
                <role>Owner</role>
                <role>Developer</role>
            </roles>
            <timezone>+8</timezone>
        </developer>
    </developers>
    <scm>
        <!-- connection 是「匿名只读取源码」的地址，给国内用户和镜像；developerConnection 是要写权限的，指向主仓库 -->
        <connection>scm:git:https://gitee.com/mailtianxi/document-parser.git</connection>
        <developerConnection>scm:git:https://github.com/hutianxi/document-parser.git</developerConnection>
        <url>https://github.com/hutianxi/document-parser</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/hutianxi/document-parser/issues</url>
    </issueManagement>

    <properties>
        <java.version>1.8</java.version>
        <!-- Aspose 各产品同版本线，jdk16 classifier 才是 Java 8 可用的字节码 -->
        <aspose.version>23.12</aspose.version>
        <!-- 覆盖 Boot 2.7.18 管理的 Jackson 2.13.5：CVE-2026-83557 / 68497 / 19032 在 2.21.6 修复，
             CVE-2026-89425 / 89407 / 91776 在 2.21.7 修复，
             CVE-2026-110879（CVE-2026-54512 的不完整修复：泛型参数与数组元素类型仍可逃逸
             PolymorphicTypeValidator）在 2.21.8 修复。Jackson 2.x 仍是 Java 8 字节码
             （jackson-databind 的 MANIFEST 写着 X-Compile-Target-JDK: 1.8），不会抬高本库的语言级别。 -->
        <jackson-bom.version>2.21.8</jackson-bom.version>
    </properties>

    <repositories>
        <repository>
            <id>AsposeJavaAPI</id>
            <name>Aspose Java API</name>
            <url>https://repository.aspose.com/repo/</url>
        </repository>
    </repositories>
    <dependencies>
        <!-- WordParser 序列化 JSON 用 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>com.aspose</groupId>
            <artifactId>aspose-words</artifactId>
            <version>${aspose.version}</version>
            <classifier>jdk16</classifier>
        </dependency>

        <!-- PdfParser：PDF 文本、表格（TableAbsorber）、图片 -->
        <dependency>
            <groupId>com.aspose</groupId>
            <artifactId>aspose-pdf</artifactId>
            <version>${aspose.version}</version>
            <classifier>jdk16</classifier>
        </dependency>

        <!-- PptParser：PPT/PPTX 文本、表格、图片 -->
        <dependency>
            <groupId>com.aspose</groupId>
            <artifactId>aspose-slides</artifactId>
            <version>${aspose.version}</version>
            <classifier>jdk16</classifier>
        </dependency>

        <!-- 测试只用 JUnit 5 的 Jupiter API，不需要 Spring Boot 的测试套件。
             这里刻意不引 spring-boot-starter-test：它会把 spring-boot 2.7.18、Spring Framework 5.3.x、
             logback 1.2.x、snakeyaml 1.30、log4j-api 2.17.2、json-smart/json-path、assertj、xmlunit、asm
             全部带进测试类路径，而这些组件在 2.7.x 线已经没有可用的安全修复版本。
             版本仍交给 Boot 2.7.18 的 BOM 管理（当前 JUnit 5.8.2），需要升级时再显式写版本。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 把 LICENSE 与 NOTICE 复制进 jar 的 META-INF：署名跟着构件走，
                 只拿到 jar（而不是整个仓库）的使用方也看得到原作者信息与第三方授权说明 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-license-notice</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- 发布到 Maven Central 才用得到的一整套：源码包、javadoc 包、GPG 签名、上传插件。
         平时构建（mvn clean test / package）不带这个 profile，所以下面这几个插件在不在本地仓库都无所谓。
         跑发布命令需要联网：mvn -P release -DskipTests=false clean deploy -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Central 要求同时上传 -sources.jar -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.2.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central 要求同时上传 -javadoc.jar；doclint 规则与 README 第 17 节里手跑的 javadoc 命令一致 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.4.1</version>
                        <configuration>
                            <encoding>UTF-8</encoding>
                            <charset>UTF-8</charset>
                            <docencoding>UTF-8</docencoding>
                            <additionalJOption>-Xdoclint:all,-missing</additionalJOption>
                            <failOnError>true</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central 只收 GPG 签过名的构件；密钥先 gpg -\-gen-key 生成，再 gpg -\-keyserver
                         keyserver.ubuntu.com -\-send-keys <KEY_ID> 推上去，否则校验阶段查不到公钥。
                         凭证写在 ~/.m2/settings.xml 的 <server><id>gpg</id> 里，不要写进本文件 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.0.1</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 走 Sonatype Central Portal（central.sonatype.com）上传，不是老的 OSSRH。
                         settings.xml 里要有 <server><id>central</id><username>门户 Token 用户名</username>
                         <password>门户 Token 密码</password></server>；autoPublish=false 表示先传到
                         Portal 的 Deployments 里等人工点发布，校验失败还能删掉重来 -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitMaxTime>3600</waitMaxTime>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
